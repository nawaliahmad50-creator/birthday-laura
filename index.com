<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#1a0514;overflow:hidden;font-family:Georgia,serif;color:white}
.page{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:radial-gradient(ellipse at 50% 30%,#e93a7a 0%,#a91e4f 45%,#4a0a2a 80%,#1a0514 100%);opacity:0;pointer-events:none;transition:.7s}
.page.active{opacity:1;pointer-events:auto}
